# Backend configuration
PORT=5000
HOST=localhost
NODE_ENV=development

# Upstream Star Wars API base URL
SWAPI_BASE_URL=https://www.swapi.tech/api
# Minimum delay between upstream SWAPI requests (ms) and max 429 retries
# SWAPI_MIN_REQUEST_INTERVAL_MS=1000
# SWAPI_MAX_RETRIES=2

# Reverse proxy trust (Express "trust proxy"). Use "1" for one proxy hop,
# "loopback" for local proxies, or a comma-free value accepted by Express.
# TRUST_PROXY=loopback

# Comma-separated CORS allowlist. If unset, all origins are allowed.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Favorites store: sqlite (default), json (legacy), or memory.
# SQLite is durable for local/Docker; Vercel/serverless falls back to memory
# because its filesystem is ephemeral.
# FAVORITES_STORE=sqlite
# FAVORITES_DB_FILE=./data/favorites.db

# Legacy JSON persistence settings (only used when FAVORITES_STORE=json or
# when either value is set without an explicit store selection).
# FAVORITES_DATA_FILE=./data/favorites.json
# FAVORITES_PERSIST=true

# Favorites capacity limits (per-process in-memory store)
# FAVORITES_MAX_USERS=10000
# FAVORITES_MAX_ITEMS=100

# Rate limiting (requests per 15 minutes per IP on /api)
API_RATE_LIMIT_MAX=300

# Response caching for list endpoints
# LIST_CACHE_CONTROL=public, max-age=60, stale-while-revalidate=300

# In-memory SWAPI response cache: max entries and default TTL
# CACHE_MAX_ENTRIES=500

# Graceful shutdown timeout in milliseconds
# SHUTDOWN_TIMEOUT_MS=10000
